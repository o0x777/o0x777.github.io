---
import Icon from './Icon.astro';
---

<dialog class="cmdk" id="cmdk" aria-label="搜索与命令">
  <div class="panel">
    <label class="field">
      <Icon name="search" size={18} />
      <input
        type="text"
        placeholder="搜索文章、标签或正文…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
      />
      <kbd class="kbd">esc</kbd>
    </label>
    <div class="list" id="cmdk-list" role="listbox" aria-label="结果"></div>
    <div class="foot mono">
      <span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> 选择</span>
      <span><kbd class="kbd">↵</kbd> 打开</span>
      <span class="count"></span>
    </div>
  </div>
</dialog>

<template id="cmdk-icons">
  <span data-i="file"><Icon name="file" size={16} /></span>
  <span data-i="home"><Icon name="home" size={16} /></span>
  <span data-i="archive"><Icon name="archive" size={16} /></span>
  <span data-i="hash"><Icon name="hash" size={16} /></span>
  <span data-i="user"><Icon name="user" size={16} /></span>
  <span data-i="contrast"><Icon name="contrast" size={16} /></span>
  <span data-i="rss"><Icon name="rss" size={16} /></span>
</template>

<script>
  type Doc = { t: string; u: string; d: string; g: string[]; n: string; date: string; x: string };
  type Item = { group: string; icon: string; title: string; hint?: string; snippet?: string; run: () => void };

  const dlg = document.getElementById('cmdk') as HTMLDialogElement;
  const input = dlg.querySelector('input')!;
  const list = dlg.querySelector<HTMLElement>('.list')!;
  const count = dlg.querySelector<HTMLElement>('.count')!;
  const icons = new Map(
    [...(document.getElementById('cmdk-icons') as HTMLTemplateElement).content.querySelectorAll('[data-i]')].map(
      (el) => [(el as HTMLElement).dataset.i!, el.innerHTML],
    ),
  );

  const go = (url: string) => () => (location.href = url);
  const pages: Item[] = [
    { group: '页面', icon: 'home', title: '首页', run: go('/') },
    { group: '页面', icon: 'archive', title: '归档', run: go('/archives/') },
    { group: '页面', icon: 'hash', title: '标签', run: go('/tags/') },
    { group: '页面', icon: 'user', title: '关于我', run: go('/about/') },
  ];
  const actions: Item[] = [
    {
      group: '操作',
      icon: 'contrast',
      title: '切换深色 / 浅色模式',
      run: () => dispatchEvent(new Event('toggle-theme')),
    },
    { group: '操作', icon: 'rss', title: '订阅 RSS', run: go('/rss.xml') },
  ];

  let docs: Doc[] | null = null;
  let items: Item[] = [];
  let active = 0;

  async function load() {
    if (docs) return;
    try {
      docs = await (await fetch('/search.json')).json();
    } catch {
      docs = [];
    }
    render();
  }

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const mark = (text: string, terms: string[]) => {
    let html = esc(text);
    for (const t of terms) {
      if (!t) continue;
      html = html.replace(new RegExp(esc(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), (m) => `<mark>${m}</mark>`);
    }
    return html;
  };
  const snippetOf = (text: string, term: string) => {
    const i = text.toLowerCase().indexOf(term);
    if (i < 0) return '';
    const start = Math.max(0, i - 24);
    return (start > 0 ? '…' : '') + text.slice(start, i + term.length + 48) + '…';
  };

  function search(q: string): Item[] {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    const all = docs ?? [];
    if (!terms.length) {
      return [
        ...all.map((d) => ({
          group: '文章',
          icon: 'file',
          title: d.t,
          hint: d.n,
          run: go(d.u),
        })),
        ...pages,
        ...actions,
      ];
    }
    const hits = all
      .map((d) => {
        let score = 0;
        for (const t of terms) {
          const s =
            (d.t.toLowerCase().includes(t) ? 8 : 0) +
            (d.g.some((g) => g.toLowerCase().includes(t)) ? 5 : 0) +
            (d.d.toLowerCase().includes(t) ? 3 : 0) +
            (d.x.toLowerCase().includes(t) ? 1 : 0);
          if (!s) return null; // every term must match somewhere
          score += s;
        }
        return { d, score };
      })
      .filter(Boolean)
      .sort((a, b) => b!.score - a!.score)
      .map(({ d }: any) => ({
        group: '文章',
        icon: 'file',
        title: d.t,
        hint: d.n,
        snippet: d.t.toLowerCase().includes(terms[0]) ? d.d : snippetOf(d.x, terms[0]) || d.d,
        run: go(d.u),
      }));
    const match = (i: Item) => terms.every((t) => i.title.toLowerCase().includes(t));
    return [...hits, ...pages.filter(match), ...actions.filter(match)];
  }

  function render() {
    const q = input.value.trim();
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    items = search(q);
    active = Math.min(active, Math.max(0, items.length - 1));
    if (!items.length) {
      list.innerHTML = `<p class="empty">没有找到与「${esc(q)}」相关的内容</p>`;
      count.textContent = '';
      return;
    }
    let html = '';
    let group = '';
    items.forEach((it, i) => {
      if (it.group !== group) {
        group = it.group;
        html += `<p class="group">${group}</p>`;
      }
      html += `<div class="item" role="option" id="cmdk-${i}" data-i="${i}" aria-selected="${i === active}">
        <span class="ic">${icons.get(it.icon) ?? ''}</span>
        <span class="txt"><span class="t">${mark(it.title, terms)}</span>${
          it.snippet ? `<span class="s">${mark(it.snippet, terms)}</span>` : ''
        }</span>
        ${it.hint ? `<span class="h mono">${esc(it.hint)}</span>` : ''}
      </div>`;
    });
    list.innerHTML = html;
    input.setAttribute('aria-activedescendant', `cmdk-${active}`);
    const n = items.filter((i) => i.group === '文章').length;
    count.textContent = docs ? `${n} 篇文章` : '加载中…';
  }

  function setActive(i: number) {
    active = (i + items.length) % items.length;
    list.querySelectorAll('.item').forEach((el) => el.setAttribute('aria-selected', String(Number((el as HTMLElement).dataset.i) === active)));
    input.setAttribute('aria-activedescendant', `cmdk-${active}`);
    list.querySelector(`[data-i="${active}"]`)?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (dlg.open) return;
    input.value = '';
    active = 0;
    render();
    dlg.showModal();
    input.focus();
    load();
  }

  input.addEventListener('input', () => {
    active = 0;
    render();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), setActive(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), setActive(active - 1));
    else if (e.key === 'Enter' && items[active]) {
      e.preventDefault();
      dlg.close();
      items[active].run();
    }
  });
  list.addEventListener('pointermove', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.item');
    if (el && Number(el.dataset.i) !== active) setActive(Number(el.dataset.i));
  });
  list.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.item');
    if (!el) return;
    dlg.close();
    items[Number(el.dataset.i)].run();
  });
  // Click on the backdrop closes
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());

  document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dlg.open ? dlg.close() : open();
    } else if (e.key === '/' && !typing && !dlg.open) {
      e.preventDefault();
      open();
    }
  });
</script>

<style is:global>
  .cmdk {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--bg-elev);
    color: var(--fg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .cmdk[open] {
    animation: cmdk-in 0.22s var(--ease);
  }
  .cmdk::backdrop {
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
  }
  .cmdk .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .cmdk .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--fg-3);
  }
  .cmdk input {
    flex: 1;
    height: 58px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 16px;
  }
  .cmdk input::placeholder {
    color: var(--fg-3);
  }
  .cmdk .list {
    flex: 1;
    overflow-y: auto;
    padding: 6px 8px 8px;
    overscroll-behavior: contain;
  }
  .cmdk .group {
    margin: 10px 10px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }
  .cmdk .item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: 10px;
    cursor: pointer;
  }
  .cmdk .item[aria-selected='true'] {
    background: var(--bg-hover);
  }
  .cmdk .ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--fg-3);
  }
  .cmdk .item[aria-selected='true'] .ic {
    color: var(--accent-text);
    border-color: var(--accent-line);
  }
  .cmdk .txt {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .cmdk .t {
    font-size: 14.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk .s {
    margin-top: 2px;
    color: var(--fg-3);
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk .h {
    color: var(--fg-3);
    font-size: 12px;
  }
  .cmdk mark {
    background: none;
    color: var(--accent-text);
  }
  .cmdk .empty {
    margin: 0;
    padding: 36px 16px;
    color: var(--fg-3);
    font-size: 14px;
    text-align: center;
  }
  .cmdk .foot {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--fg-3);
    font-size: 11.5px;
  }
  .cmdk .foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .cmdk .foot .count {
    margin-left: auto;
  }
  @media (max-width: 640px) {
    .cmdk {
      margin-top: 72px;
    }
    .cmdk .foot {
      display: none;
    }
  }
</style>
