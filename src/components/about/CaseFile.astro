---
// "Case file" card for the About hero: generated fingerprint, profile fields
// with redactions, status, barcode and a DECLASSIFIED stamp.
import { ABOUT } from '../../lib/about';

// Deterministic PRNG so the fingerprint and barcode never change between builds
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Fingerprint: concentric ovals broken into arcs, a few "matched" ridges in accent
const rand = rng(0x777);
const cx = 60;
const cy = 80;
const ridges: { d: string; hot: boolean }[] = [];
for (let i = 1; i <= 13; i++) {
  const rx = 5 + i * 3.7;
  const ry = rx * 1.3;
  let a = rand() * 360;
  const end = a + 360;
  while (a < end - 20) {
    const len = Math.min(end - a, 50 + rand() * 120);
    const gap = 8 + rand() * 26;
    const t0 = (a * Math.PI) / 180;
    const t1 = ((a + len - gap) * Math.PI) / 180;
    const p = (t: number) => `${(cx + rx * Math.cos(t)).toFixed(2)} ${(cy + ry * Math.sin(t)).toFixed(2)}`;
    const large = len - gap > 180 ? 1 : 0;
    ridges.push({ d: `M${p(t0)} A${rx.toFixed(2)} ${ry.toFixed(2)} 0 ${large} 1 ${p(t1)}`, hot: rand() < 0.09 });
    a += len;
  }
}

// Barcode stripes
const brand = rng(7770);
const bars: { x: number; w: number }[] = [];
for (let x = 0; x < 120; ) {
  const w = 1 + Math.floor(brand() * 3);
  if (brand() > 0.35) bars.push({ x, w });
  x += w + 1 + Math.floor(brand() * 2);
}
---

<div class="case" data-spot>
  <div class="case-head mono">
    <span>CASE FILE · <b>0x777</b></span>
    <span class="tlp">TLP:CLEAR</span>
  </div>

  <div class="case-body">
    <figure class="print">
      <svg viewBox="0 0 120 160" aria-hidden="true">
        {ridges.map((r) => <path d={r.d} class:list={{ hot: r.hot }} />)}
      </svg>
      <span class="scan" aria-hidden="true"></span>
      <figcaption class="mono">生物特征 · 已隐去</figcaption>
    </figure>

    <dl class="fields">
      {
        ABOUT.profile.map((f) => (
          <div>
            <dt>
              {f.k}
              <span class="mono">{f.en}</span>
            </dt>
            <dd class="mono">
              {f.redacted ? (
                <span
                  class="redact"
                  tabindex="0"
                  role="img"
                  aria-label={`${f.k}：已隐去`}
                  data-tip="REDACTED · 保持隐秘"
                  style={`--w:${f.width}`}
                />
              ) : (
                f.v
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="case-foot mono">
    <span class="status"><span class="dot" aria-hidden="true"></span>追踪中 · ACTIVE</span>
    <svg class="barcode" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true">
      {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="20" />)}
    </svg>
  </div>

  <div class="stamp mono" aria-hidden="true">
    已解密
    <small>DECLASSIFIED</small>
  </div>
</div>

<style>
  .case {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background:
      linear-gradient(to bottom, color-mix(in oklab, var(--bg-elev) 92%, var(--accent)) , var(--bg-elev) 40%);
    box-shadow: var(--shadow-lg);
  }

  .case-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px dashed var(--line-strong);
    color: var(--fg-3);
    font-size: 11.5px;
    letter-spacing: 0.1em;
  }
  .case-head b {
    color: var(--fg);
    font-weight: 600;
  }
  .tlp {
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 10px;
  }

  .case-body {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    gap: 22px;
    padding: 22px 20px;
  }

  /* Fingerprint */
  .print {
    position: relative;
    margin: 0;
    align-self: start;
    padding: 10px 8px 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-inset);
    overflow: hidden;
  }
  .print svg {
    width: 100%;
    height: auto;
  }
  .print path {
    fill: none;
    stroke: var(--fg-3);
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .print path.hot {
    stroke: var(--accent);
    opacity: 1;
    filter: drop-shadow(0 0 3px var(--glow));
  }
  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 28px;
    background: linear-gradient(to bottom, transparent, var(--accent-soft) 60%, var(--accent) 61%, transparent 64%);
    animation: scan 3.6s var(--ease) infinite alternate;
    pointer-events: none;
  }
  @keyframes scan {
    from {
      transform: translateY(-20px);
    }
    to {
      transform: translateY(150px);
    }
  }
  .print figcaption {
    margin: 4px -8px 0;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    color: var(--fg-3);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-align: center;
  }

  /* Fields */
  .fields {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .fields div {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }
  .fields div:last-child {
    border-bottom: 0;
  }
  .fields dt {
    display: flex;
    flex-direction: column;
    color: var(--fg-2);
    font-size: 13px;
    line-height: 1.3;
  }
  .fields dt span {
    margin-top: 2px;
    color: var(--fg-3);
    font-size: 9.5px;
    letter-spacing: 0.1em;
  }
  .fields dd {
    margin: 0;
    color: var(--fg);
    font-size: 13.5px;
    overflow-wrap: anywhere;
  }

  /* Redaction bar: hatch pattern, tooltip on hover/focus */
  .redact {
    position: relative;
    display: inline-block;
    width: calc(var(--w) * 1ch + 8px);
    height: 1.05em;
    vertical-align: -0.15em;
    border-radius: 2px;
    background: repeating-linear-gradient(-45deg, var(--fg-2) 0 2px, transparent 2px 5px), var(--line-strong);
    cursor: help;
    transition: filter 0.2s;
  }
  .redact::after {
    content: attr(data-tip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    padding: 5px 9px;
    border: 1px solid var(--accent-line);
    border-radius: 6px;
    background: var(--bg);
    color: var(--accent-text);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease);
    pointer-events: none;
  }
  .redact:hover,
  .redact:focus-visible {
    filter: brightness(1.3);
  }
  .redact:hover::after,
  .redact:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .case-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    border-top: 1px dashed var(--line-strong);
    font-size: 11.5px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-text);
    letter-spacing: 0.06em;
  }
  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .barcode {
    width: 108px;
    height: 20px;
    fill: var(--fg-3);
    opacity: 0.8;
  }

  /* DECLASSIFIED stamp */
  .stamp {
    position: absolute;
    right: -14px;
    top: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 12px 5px;
    border: 2px solid var(--accent);
    border-radius: 6px;
    outline: 1px solid var(--accent);
    outline-offset: 2px;
    color: var(--accent);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.3em;
    line-height: 1.1;
    text-indent: 0.3em;
    opacity: 0.88;
    transform: rotate(-9deg);
    text-shadow: 0 0 12px var(--glow);
    animation: stamp 0.55s 1.1s cubic-bezier(0.3, 1.6, 0.5, 1) both;
    pointer-events: none;
  }
  .stamp small {
    font-size: 8.5px;
    letter-spacing: 0.32em;
    font-weight: 600;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-16deg) scale(1.9);
    }
  }

  @media (max-width: 520px) {
    .case-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .print {
      width: 132px;
    }
    .stamp {
      right: 10px;
      bottom: auto;
      top: 72px;
    }
  }
</style>
