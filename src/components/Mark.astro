---
// Logo mark: a C2 node with three bots.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg class:list={['mark', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.55">
    <path d="M12 12 4.5 5.5M12 12l7.5-6.5M12 12v8.5"></path>
  </g>
  <circle cx="4.5" cy="5.5" r="2" fill="currentColor"></circle>
  <circle cx="19.5" cy="5.5" r="2" fill="currentColor"></circle>
  <circle cx="12" cy="20.5" r="2" fill="currentColor"></circle>
  <circle cx="12" cy="12" r="3.6" fill="var(--accent)"></circle>
</svg>
