---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CaseFile from '../components/about/CaseFile.astro';
import Terminal from '../components/about/Terminal.astro';
import { ABOUT } from '../lib/about';
import { SITE, dateParts, getPosts, postUrl, reportIds, wordCount } from '../lib/site';

const posts = await getPosts();
const ids = reportIds(posts);
const oldest = posts.at(-1);
const stats = [
  { n: Number(oldest ? dateParts(oldest.data.pubDate).year : SITE.since), label: '首份报告', plain: true },
  { n: posts.length, label: '份公开报告' },
  { n: posts.reduce((sum, p) => sum + wordCount(p.body), 0), label: '字研究笔记' },
  { n: 10, suffix: '+', label: '个到访国家' },
];

// Mini botnet for the featured focus card (deterministic)
let seed = 0x0777;
const rand = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};
const c2 = { x: 210, y: 92 };
const bots = Array.from({ length: 26 }, () => ({ x: 40 + rand() * 340, y: 14 + rand() * 170 }));
const peers = bots.flatMap((b, i) =>
  bots
    .map((o, j) => ({ j, d: Math.hypot(b.x - o.x, b.y - o.y) }))
    .filter((o) => o.j > i && o.d < 62)
    .map((o) => ({ a: b, b: bots[o.j] })),
);
---

<Base title="关于我" description="0x777 — 网络安全从业者，专注二进制安全、僵尸网络分析与黑灰产溯源打击。">
  <!-- ========== Hero ========== -->
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow" data-reveal><span class="accent">/</span> About · Subject Profile</p>
      <h1 data-reveal style="--d:1">
        <span class="hi">你好，</span>
        <span>我是 <span class="handle mono" data-scramble>0x777</span>。</span>
      </h1>
      <p class="lead" data-reveal style="--d:2">{ABOUT.lead}</p>
      <div class="cta" data-reveal style="--d:3">
        <a class="btn btn-primary" href="#contact"><Icon name="mail" size={16} />发个信号</a>
        <a class="btn btn-ghost" href="#terminal">打开终端 <span class="mono prompt-glyph">›_</span></a>
      </div>
    </div>
    <div class="file" data-reveal style="--d:2">
      <CaseFile />
    </div>
  </section>

  <section class="container" aria-label="数据">
    <dl class="stats" data-reveal>
      {
        stats.map((s) => (
          <div>
            <dt class="mono">
              <span data-count={s.n} data-plain={s.plain ? '' : undefined}>
                {s.plain ? s.n : s.n.toLocaleString('en-US')}
              </span>
              {s.suffix && <span class="suffix">{s.suffix}</span>}
            </dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ========== 01 Creed ========== -->
  <section class="container creed" aria-labelledby="creed-title">
    <p class="eyebrow" id="creed-title"><span class="accent">01</span> — Creed · 信条</p>
    <ol>
      {
        ABOUT.creed.map((c, i) => (
          <li data-creed>
            <span class="n mono">0{i + 1}</span>
            <h2>{c.title}</h2>
            <p>{c.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 02 Method ========== -->
  <section class="container section" aria-labelledby="method-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">02</span> — Method</p>
        <h2 id="method-title">从一个样本，到一张网</h2>
      </div>
      <p class="note">我的僵尸网络研究流程</p>
    </div>
    <ol class="pipeline" data-reveal>
      <span class="rail" aria-hidden="true"><span class="packet"></span></span>
      {
        ABOUT.method.map((m, i) => (
          <li style={`--d:${i}`}>
            <span class="node" aria-hidden="true" />
            <p class="idx mono">
              0{i + 1} · {m.en}
            </p>
            <h3>{m.title}</h3>
            <p class="body">{m.body}</p>
            <ul class="tools">
              {m.tools.map((t) => (
                <li class="mono">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 03 Focus ========== -->
  <section class="container section" aria-labelledby="focus-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">03</span> — Focus</p>
        <h2 id="focus-title">研究方向</h2>
      </div>
    </div>
    <ul class="bento">
      {
        ABOUT.focus.map((f, i) => (
          <li class:list={['tile', `t${i}`, { featured: f.featured }]} data-spot data-reveal style={`--d:${i}`}>
            <span class="tile-icon">
              <Icon name={f.icon as any} size={20} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            {f.featured && (
              <svg class="mini-net" viewBox="0 0 420 200" aria-hidden="true">
                {peers.map((e) => (
                  <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} class="p2p" />
                ))}
                {bots.map((b) => (
                  <line x1={c2.x} y1={c2.y} x2={b.x} y2={b.y} class="cs" />
                ))}
                {bots.map((b) => (
                  <circle cx={b.x} cy={b.y} r="2.2" class="bot" />
                ))}
                <circle cx={c2.x} cy={c2.y} r="14" class="c2-ring" />
                <circle cx={c2.x} cy={c2.y} r="5" class="c2" />
              </svg>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ========== 04 Reports ========== -->
  <section class="container section" aria-labelledby="reports-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">04</span> — Reports</p>
        <h2 id="reports-title">公开报告</h2>
      </div>
      <a class="link-arrow" href="/archives/">全部归档 <span>→</span></a>
    </div>
    <div class="reports">
      {
        posts.map((p, i) => (
          <a class="report" href={postUrl(p)} data-spot data-reveal style={`--d:${i}`}>
            <div class="r-top mono">
              <span class="rid">REPORT {ids.get(p.id)}</span>
              <span>{dateParts(p.data.pubDate).year}</span>
            </div>
            <h3>{p.data.title}</h3>
            <p class="r-desc">{p.data.description}</p>
            {ABOUT.reportHighlights[p.data.slug] && (
              <dl class="metrics">
                {ABOUT.reportHighlights[p.data.slug].map((h) => (
                  <div>
                    <dt class="mono">{h.n}</dt>
                    <dd>{h.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <span class="r-go">
              阅读报告 <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ========== 05 Terminal ========== -->
  <section class="container section" id="terminal" aria-labelledby="term-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">05</span> — Shell</p>
        <h2 id="term-title">和我的终端聊聊</h2>
      </div>
      <p class="note">试试输入 <code class="mono">help</code></p>
    </div>
    <div data-reveal><Terminal /></div>
  </section>

  <!-- ========== 06 Off the clock ========== -->
  <section class="container section" aria-labelledby="life-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">06</span> — Off the clock</p>
        <h2 id="life-title">档案之外</h2>
      </div>
    </div>
    <div class="life">
      <article class="card pass" data-spot data-reveal>
        <div class="pass-head mono">
          <span>BOARDING PASS</span>
          <Icon name="plane" size={16} />
        </div>
        <div class="route mono">
          <div><small>FROM</small><b>127.0.0.1</b></div>
          <span class="arrow" aria-hidden="true"></span>
          <div class="to"><small>TO</small><b>{ABOUT.countries}</b></div>
        </div>
        <dl class="pass-meta mono">
          <div><dt>PASSENGER</dt><dd>0x777</dd></div>
          <div><dt>PURPOSE</dt><dd>CON · HACKER CULTURE</dd></div>
        </dl>
        <p>{ABOUT.interests.travel}</p>
      </article>

      <article class="card arcade" data-spot data-reveal style="--d:1">
        <div class="screen mono" aria-hidden="true">
          <div class="hud"><span>1UP 0x777</span><span>HI 7777</span></div>
          <p class="start">PRESS START</p>
          <p class="credit">CREDIT 01</p>
        </div>
        <p>{ABOUT.interests.games}</p>
        <a class="hint mono" href="#terminal">&gt; 提示：去终端里 <b>ls -a</b></a>
      </article>

      <article class="card shelf" data-spot data-reveal style="--d:2">
        <div class="books" aria-hidden="true">
          {ABOUT.interests.books.map((b, i) => <span class={`spine s${i}`}>{b}</span>)}
          <span class="spine ghost"></span>
        </div>
        <p>喜欢读{ABOUT.interests.books.join('、')}。</p>
      </article>
    </div>
  </section>

  <!-- ========== 07 Contact ========== -->
  <section class="container section" id="contact" aria-labelledby="contact-title">
    <div class="signal" data-reveal>
      <div class="radar" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="accent">07</span> — Contact</p>
      <h2 id="contact-title">有线索？<br />发个<em>信号</em>。</h2>
      <p class="sub">{ABOUT.contact.body}</p>
      <div class="mailbox">
        <a class="addr mono" href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a>
        <button class="copy" type="button" data-copy={SITE.links.email} aria-label="复制邮箱地址">
          <Icon name="copy" size={15} class="i-copy" />
          <Icon name="check" size={15} class="i-check" />
          <span data-copy-label>复制</span>
        </button>
      </div>
      <div class="links">
        <a class="btn btn-ghost" href={SITE.links.x} target="_blank" rel="me noopener"
          ><Icon name="x" size={14} />{SITE.links.xHandle}</a
        >
        <a class="btn btn-ghost" href={SITE.links.github} target="_blank" rel="me noopener"
          ><Icon name="github" size={16} />GitHub</a
        >
        <a class="btn btn-ghost" href="/rss.xml"><Icon name="rss" size={16} />RSS</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Decrypt effect on the handle
  const handle = document.querySelector<HTMLElement>('[data-scramble]');
  if (handle && !reduced) {
    const final = handle.textContent!.trim();
    const glyphs = '01#$%&@!x7ABCDEF';
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start - 350) / 900);
      const locked = Math.floor(Math.max(0, p) * final.length);
      handle.textContent = [...final]
        .map((ch, i) => (i < locked ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (p < 1) requestAnimationFrame(tick);
      else handle.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  // Count-up for the stats strip
  const stats = document.querySelector('.stats');
  if (stats) {
    const run = () =>
      stats.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const target = Number(el.dataset.count);
        const plain = el.hasAttribute('data-plain');
        const fmt = (v: number) => (plain ? String(v) : v.toLocaleString('en-US'));
        if (reduced || plain) return void (el.textContent = fmt(target));
        const t0 = performance.now();
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / 1400);
          el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - k, 4))));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    new IntersectionObserver((entries, io) => {
      if (entries[0].isIntersecting) (run(), io.disconnect());
    }).observe(stats);
  }

  // Creed: each line lights up as it crosses the middle of the screen
  const lines = document.querySelectorAll('[data-creed]');
  const creedIO = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.target.toggleAttribute('data-lit', e.isIntersecting)),
    { rootMargin: '-38% 0px -38% 0px' },
  );
  lines.forEach((l) => creedIO.observe(l));

  // Copy e-mail
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.setAttribute('data-done', '');
        label.textContent = '已复制';
      } catch {
        label.textContent = '复制失败';
      }
      setTimeout(() => {
        btn.removeAttribute('data-done');
        label.textContent = '复制';
      }, 1800);
    }),
  );

  // For the people who open DevTools
  console.log(
    '%c0x777%c\n保持好奇，保持隐秘，追踪暗影。\n这一页的终端里藏着一个 flag —— 试试 ls -a',
    'font: 700 28px ui-monospace, monospace; color: #39ff88; text-shadow: 0 0 12px rgba(57,255,136,.6)',
    'font: 12px ui-monospace, monospace; color: #98a69d; line-height: 1.8',
  );
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: clamp(48px, 8vw, 104px);
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: 22px 0 24px;
    font-size: clamp(38px, 6.2vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 .hi {
    color: var(--fg-3);
  }
  h1 > span {
    white-space: nowrap;
  }
  .handle {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.05em;
    text-shadow: 0 0 36px var(--glow);
  }
  .lead {
    max-width: 34em;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.9;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .prompt-glyph {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(64px, 9vw, 104px) 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats div {
    padding: 28px 0 28px 28px;
    border-left: 1px solid var(--line);
  }
  .stats div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stats dt {
    font-size: clamp(34px, 4.6vw, 52px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stats .suffix {
    color: var(--accent);
  }
  .stats dd {
    margin: 12px 0 0;
    color: var(--fg-3);
    font-size: 14px;
  }

  /* ---------- Creed ---------- */
  .creed {
    padding-top: clamp(96px, 14vw, 180px);
  }
  .creed ol {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .creed li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    column-gap: 16px;
    align-items: baseline;
    padding: clamp(20px, 3vw, 36px) 0;
    border-bottom: 1px solid var(--line);
  }
  .creed .n {
    grid-row: span 2;
    color: var(--fg-3);
    font-size: 13px;
    transition: color 0.5s;
  }
  .creed h2 {
    margin: 0;
    font-size: clamp(40px, 8.4vw, 104px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    transition:
      color 0.6s var(--ease),
      text-shadow 0.6s;
  }
  .creed p {
    max-width: 30em;
    margin: 14px 0 0;
    color: var(--fg-2);
    font-size: clamp(15px, 1.6vw, 18px);
    transition: opacity 0.6s;
  }
  /* Dim until lit (only when JS can light them up) */
  :global(.js) .creed li:not([data-lit]) h2 {
    color: color-mix(in oklab, var(--fg) 18%, var(--bg));
  }
  :global(.js) .creed li:not([data-lit]) p {
    opacity: 0.35;
  }
  .creed li[data-lit] .n {
    color: var(--accent-text);
  }
  .creed li[data-lit] h2 {
    text-shadow: 0 0 60px color-mix(in oklab, var(--glow) 40%, transparent);
  }

  /* ---------- Section scaffolding ---------- */
  .section {
    padding-top: clamp(96px, 12vw, 152px);
  }
  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 14px;
  }
  .note code {
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent-text);
    font-size: 13px;
  }

  /* ---------- Method pipeline ---------- */
  .pipeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 7px;
    left: 8px;
    right: 8px;
    height: 1px;
    background: linear-gradient(to right, var(--accent-line), var(--line-strong) 60%, var(--line));
    overflow: hidden;
  }
  .packet {
    position: absolute;
    top: -1px;
    left: 0;
    width: 64px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(to right, transparent, var(--accent));
    box-shadow: 0 0 12px var(--glow);
    opacity: 0;
  }
  .pipeline[data-in] .packet {
    animation: travel 3.6s 0.6s var(--ease) infinite;
  }
  @keyframes travel {
    0% {
      transform: translateX(-64px);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateX(min(100vw, 1160px));
      opacity: 0;
    }
  }
  .pipeline > li {
    position: relative;
    padding-top: 40px;
  }
  /* Stages light up one after another */
  :global(.js) .pipeline > li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(0.15s + var(--d) * 0.14s);
  }
  :global(.js) .pipeline[data-in] > li {
    opacity: 1;
    transform: none;
  }
  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border: 1px solid var(--accent-line);
    border-radius: 50%;
    background: var(--bg);
  }
  .node::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--glow);
  }
  .pipeline .idx {
    margin: 0 0 10px;
    color: var(--fg-3);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pipeline h3 {
    margin: 0 0 10px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .pipeline .body {
    margin: 0 0 18px;
    color: var(--fg-2);
    font-size: 14.5px;
    line-height: 1.8;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--fg-2);
    font-size: 11.5px;
  }

  /* ---------- Focus bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'f f a'
      'f f b'
      'c d d';
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .t0 {
    grid-area: f;
  }
  .t1 {
    grid-area: a;
  }
  .t2 {
    grid-area: b;
  }
  .t3 {
    grid-area: c;
  }
  .t4 {
    grid-area: d;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-elev);
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .tile:hover {
    border-color: var(--line-strong);
  }
  .tile-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 28px;
    border: 1px solid var(--line-strong);
    border-radius: 11px;
    color: var(--fg-2);
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .tile:hover .tile-icon {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .tile h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tile p {
