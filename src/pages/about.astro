---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CaseFile from '../components/about/CaseFile.astro';
import Terminal from '../components/about/Terminal.astro';
import { ABOUT } from '../lib/about';
import { SITE } from '../lib/site';

// "攻防出身。" on its own line, the rest below it
const [leadHead, ...leadRest] = ABOUT.lead.split(/(?<=。)/);
---

<Base title="关于我" description="0x777 — 攻防出身：拆解过代码，追踪过暗影，如今守护数据。">
  <!-- ========== Hero ========== -->
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow" data-reveal><span class="accent">/</span> About · Subject Profile</p>
      <h1 data-reveal style="--d:1">
        <span class="hi">你好，</span>
        <span>我是 <span class="handle mono" data-scramble>0x777</span>。</span>
      </h1>
      <p class="lead" data-reveal style="--d:2">
        <span class="l1">{leadHead}</span>
        <span>{leadRest.join('')}</span>
      </p>
      <div class="cta" data-reveal style="--d:3">
        <a class="btn btn-primary" href={`mailto:${SITE.links.email}`}><Icon name="mail" size={16} />发个信号</a>
        <a class="btn btn-ghost" href="#terminal">打开终端 <span class="mono prompt-glyph">›_</span></a>
      </div>
    </div>
    <div class="file" data-reveal style="--d:2">
      <CaseFile />
    </div>
  </section>

  <!-- ========== 01 Trajectory + skills ========== -->
  <section class="container section" aria-labelledby="path-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">01</span> — Trajectory · Skills</p>
        <h2 id="path-title">安全轨迹</h2>
      </div>
      <p class="note">从进攻，到守护。</p>
    </div>

    <ol class="chain" data-reveal>
      {
        ABOUT.career.map((c, i) => (
          <li class:list={['stage', { now: c.now }]} style={`--d:${i}; --mix:${5 + i * 5}%`}>
            <div class="chev-wrap">
              <div class="chev">
                <p class="chev-meta mono">
                  0{i + 1} · {c.en}
                  {c.now && <span class="now-tag">NOW</span>}
                </p>
                <h3 class="verb">{c.verb}</h3>
              </div>
            </div>
            <div class="info">
              <p class="dom">{c.domain}</p>
              <p class="line">{c.line}</p>
              <ul class="skills" aria-label={`技能：${c.skills.join('、')}`}>
                {c.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 02 Shell ========== -->
  <section class="container section" id="terminal" aria-labelledby="term-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">02</span> — Shell</p>
        <h2 id="term-title">和我的终端聊聊</h2>
      </div>
      <p class="note">试试输入 <code class="mono">help</code></p>
    </div>
    <div data-reveal><Terminal /></div>
  </section>
</Base>

<script>
  // Decrypt effect on the handle
  const handle = document.querySelector<HTMLElement>('[data-scramble]');
  if (handle && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const final = handle.textContent!.trim();
    const glyphs = '01#$%&@!x7ABCDEF';
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start - 350) / 900);
      const locked = Math.floor(Math.max(0, p) * final.length);
      handle.textContent = [...final]
        .map((ch, i) => (i < locked ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (p < 1) requestAnimationFrame(tick);
      else handle.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  // For the people who open DevTools
  console.log(
    '%c0x777%c\n保持好奇，保持隐秘，追踪暗影。\n这一页的终端里藏着一个 flag —— 试试 ls -a',
    'font: 700 28px ui-monospace, monospace; color: #39ff88; text-shadow: 0 0 12px rgba(57,255,136,.6)',
    'font: 12px ui-monospace, monospace; color: #98a69d; line-height: 1.8',
  );
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: clamp(48px, 8vw, 104px);
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: 22px 0;
    font-size: clamp(38px, 6.2vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 .hi {
    color: var(--fg-3);
  }
  h1 > span {
    white-space: nowrap;
  }
  .handle {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.05em;
    text-shadow: 0 0 36px var(--glow);
  }
  /* One-line statement */
  .lead {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.7;
    letter-spacing: -0.01em;
    word-break: keep-all;
  }
  .lead .l1 {
    color: var(--fg);
    font-weight: 500;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .prompt-glyph {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(80px, 10vw, 128px);
  }
  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 14px;
  }
  .note code {
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent-text);
    font-size: 13px;
  }

  /* ---------- 01 Kill chain: five interlocking arrows, left → right ---------- */
  .chain {
    --tip: 22px; /* depth of each arrow point / notch */
    --gap: 6px; /* visible gap between neighbouring arrows */
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .stage {
    min-width: 0;
  }

  /* Arrow banner. The wrapper carries the glow (filters get clipped otherwise). */
  .chev-wrap {
    position: relative;
    margin-right: calc((var(--tip) - var(--gap)) * -1);
    transition:
      filter 0.3s,
      transform 0.4s var(--ease);
  }
  .stage:last-child .chev-wrap {
    margin-right: 0;
  }
  .chev {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 96px;
    padding: 0 calc(var(--tip) + 12px) 0 calc(var(--tip) + 16px);
    background: color-mix(in oklab, var(--accent) var(--mix), var(--bg-elev));
    clip-path: polygon(
      0 0,
      calc(100% - var(--tip)) 0,
      100% 50%,
      calc(100% - var(--tip)) 100%,
      0 100%,
      var(--tip) 50%
    );
  }
  .stage:first-child .chev {
    padding-left: 20px;
    border-radius: 10px 0 0 10px;
    clip-path: polygon(0 0, calc(100% - var(--tip)) 0, 100% 50%, calc(100% - var(--tip)) 100%, 0 100%);
  }
  .chev-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: var(--fg-3);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .verb {
    margin: 0;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Current stage: solid phosphor green */
  .now .chev {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .now .chev-meta {
    color: color-mix(in oklab, var(--accent-ink) 70%, var(--accent));
  }
  .now .chev-wrap {
    filter: drop-shadow(0 0 22px color-mix(in oklab, var(--glow) 70%, transparent));
  }
  .now-tag {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--accent-ink);
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
  }

  .stage:not(.now):hover .chev-wrap {
    filter: brightness(1.35);
  }

  /* Column under each arrow */
  .info {
    padding: 26px 20px 0 calc(var(--tip) + 16px);
  }
  .stage:first-child .info {
    padding-left: 20px;
  }
  .dom {
    margin: 0 0 10px;
    color: var(--fg-3);
    font-size: 13px;
    font-weight: 500;
  }
  .line {
    margin: 0 0 18px;
    color: var(--fg);
    font-size: 15px;
    line-height: 1.7;
    /* Break at punctuation/spaces only: "从 CTF 开始，/ 读懂每一行汇编。" */
    word-break: keep-all;
  }
  .skills {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 14px 0 0;
    list-style: none;
    border-top: 1px dashed var(--line-strong);
    color: var(--fg-2);
    font-size: 14px;
    transition: color 0.3s;
  }
  .skills li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .skills li::before {
    content: '';
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .stage:hover .skills {
    color: var(--fg);
  }
  .now .skills {
    color: var(--accent-text);
  }

  /* Arrows slide in from the left, one after another */
  :global(.js) .stage {
    opacity: 0;
    transform: translateX(-18px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
    transition-delay: calc(0.15s + var(--d) * 0.16s);
  }
  :global(.js) .chain[data-in] .stage {
    opacity: 1;
    transform: none;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .file {
      max-width: 520px;
    }
  }
  /* Narrow screens: arrows point down and stack */
  @media (max-width: 860px) {
    .chain {
      --tip: 14px;
      grid-template-columns: minmax(0, 1fr);
    }
    .chev-wrap,
    .stage:last-child .chev-wrap {
      margin-right: 0;
    }
    .chev,
    .stage:first-child .chev {
      height: auto;
      padding: 16px 20px calc(var(--tip) + 14px);
      border-radius: 0;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--tip)), 50% 100%, 0 calc(100% - var(--tip)));
    }
    .stage:first-child .chev {
      border-radius: 10px 10px 0 0;
    }
    .info,
    .stage:first-child .info {
      padding: 18px 4px 32px;
    }
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    :global(.js) .stage {
      transform: translateY(14px);
    }
  }
</style>
