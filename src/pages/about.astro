---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CaseFile from '../components/about/CaseFile.astro';
import Terminal from '../components/about/Terminal.astro';
import { ABOUT } from '../lib/about';
import { SITE } from '../lib/site';
---

<Base title="关于我" description="0x777 — 安全从业者，攻防出身：逆向、威胁情报、业务安全与数据安全。">
  <!-- ========== Hero ========== -->
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow" data-reveal><span class="accent">/</span> About · Subject Profile</p>
      <h1 data-reveal style="--d:1">
        <span class="hi">你好，</span>
        <span>我是 <span class="handle mono" data-scramble>0x777</span>。</span>
      </h1>
      <p class="path mono" data-reveal style="--d:2" aria-label={`安全轨迹：${ABOUT.path.join('，')}`}>
        {
          ABOUT.path.map((p, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">→</span>}
              <span class:list={{ now: i === ABOUT.path.length - 1 }}>{p}</span>
            </>
          ))
        }
      </p>
      <p class="lead" data-reveal style="--d:3">{ABOUT.lead}</p>
      <div class="cta" data-reveal style="--d:4">
        <a class="btn btn-primary" href={`mailto:${SITE.links.email}`}><Icon name="mail" size={16} />发个信号</a>
        <a class="btn btn-ghost" href="#terminal">打开终端 <span class="mono prompt-glyph">›_</span></a>
      </div>
    </div>
    <div class="file" data-reveal style="--d:2">
      <CaseFile />
    </div>
  </section>

  <!-- ========== 01 Trajectory ========== -->
  <section class="container section" aria-labelledby="career-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">01</span> — Trajectory</p>
        <h2 id="career-title">安全轨迹</h2>
      </div>
      <p class="note">攻防出身，一路走到数据安全</p>
    </div>
    <ol class="track" data-reveal>
      <span class="rail" aria-hidden="true"><span class="fill"></span></span>
      {
        ABOUT.career.map((c, i) => (
          <li class:list={{ now: c.now }} style={`--d:${i}`}>
            <span class="node" aria-hidden="true" />
            <p class="idx mono">
              0{i + 1} · {c.en}
              {c.now && <span class="now-tag">NOW</span>}
            </p>
            <h3>{c.title}</h3>
            <p class="body">{c.body}</p>
            <ul class="keys">
              {c.keys.map((k) => (
                <li class="mono">{k}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 02 Skills ========== -->
  <section class="container section" aria-labelledby="skills-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">02</span> — Skills</p>
        <h2 id="skills-title">技能图谱</h2>
      </div>
    </div>
    <ul class="skills">
      {
        ABOUT.skills.map((s, i) => (
          <li data-reveal style={`--d:${i}`}>
            <div class="domain">
              <span class="d-icon">
                <Icon name={s.icon as any} size={19} />
              </span>
              <div>
                <h3>{s.domain}</h3>
                <p class="mono">{s.en}</p>
              </div>
            </div>
            <ul class="items">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ========== 03 Shell ========== -->
  <section class="container section" id="terminal" aria-labelledby="term-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">03</span> — Shell</p>
        <h2 id="term-title">和我的终端聊聊</h2>
      </div>
      <p class="note">试试输入 <code class="mono">help</code></p>
    </div>
    <div data-reveal><Terminal /></div>
  </section>
</Base>

<script>
  // Decrypt effect on the handle
  const handle = document.querySelector<HTMLElement>('[data-scramble]');
  if (handle && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const final = handle.textContent!.trim();
    const glyphs = '01#$%&@!x7ABCDEF';
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start - 350) / 900);
      const locked = Math.floor(Math.max(0, p) * final.length);
      handle.textContent = [...final]
        .map((ch, i) => (i < locked ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (p < 1) requestAnimationFrame(tick);
      else handle.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  // For the people who open DevTools
  console.log(
    '%c0x777%c\n保持好奇，保持隐秘，追踪暗影。\n这一页的终端里藏着一个 flag —— 试试 ls -a',
    'font: 700 28px ui-monospace, monospace; color: #39ff88; text-shadow: 0 0 12px rgba(57,255,136,.6)',
    'font: 12px ui-monospace, monospace; color: #98a69d; line-height: 1.8',
  );
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: clamp(48px, 8vw, 104px);
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: 22px 0;
    font-size: clamp(38px, 6.2vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 .hi {
    color: var(--fg-3);
  }
  h1 > span {
    white-space: nowrap;
  }
  .handle {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.05em;
    text-shadow: 0 0 36px var(--glow);
  }
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 22px;
    color: var(--fg-2);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .path .sep {
    color: var(--fg-3);
  }
  .path .now {
    padding: 2px 8px;
    border: 1px solid var(--accent-line);
    border-radius: 6px;
    color: var(--accent-text);
    background: var(--accent-soft);
  }
  .lead {
    max-width: 32em;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.9;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .prompt-glyph {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(80px, 10vw, 128px);
  }
  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 14px;
  }
  .note code {
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent-text);
    font-size: 13px;
  }

  /* ---------- 01 Trajectory ---------- */
  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 7px;
    left: 8px;
    right: 8px;
    height: 1px;
    background: var(--line-strong);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--line-strong), var(--accent));
    box-shadow: 0 0 10px var(--glow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s 0.2s var(--ease);
  }
  .track[data-in] .fill,
  :global(html:not(.js)) .fill {
    transform: none;
  }
  .track > li {
    position: relative;
    padding-top: 40px;
  }
  /* Stages light up one after another, following the fill */
  :global(.js) .track > li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(0.2s + var(--d) * 0.22s);
  }
  :global(.js) .track[data-in] > li {
    opacity: 1;
    transform: none;
  }
  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
  }
  .node::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .now .node {
    border-color: var(--accent-line);
  }
  .now .node::after {
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }
  .now .node::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: ping 2.2s var(--ease) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .idx {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .now-tag {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 9.5px;
    font-weight: 700;
  }
  .track h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .now h3 {
    color: var(--accent-text);
  }
  .track .body {
    margin: 0 0 16px;
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.8;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .keys li {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--fg-2);
    font-size: 11.5px;
  }
  .now .keys li {
    border-color: var(--accent-line);
    color: var(--accent-text);
  }

  /* ---------- 02 Skills ---------- */
  .skills {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .skills > li {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    margin: 0 -16px;
    padding: 22px 16px;
    border-bottom: 1px solid var(--line);
    border-radius: 14px;
    transition: background-color 0.25s;
  }
  .skills > li:hover {
    background: var(--bg-hover);
  }
  .domain {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .d-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 11px;
    color: var(--fg-2);
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .skills > li:hover .d-icon {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .domain h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .domain p {
    margin: 2px 0 0;
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--fg-2);
    font-size: 14px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .skills > li:hover .items li {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 44px;
    }
    .rail {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .file {
      max-width: 520px;
    }
  }
  @media (max-width: 760px) {
    .skills > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      margin: 0;
      padding: 22px 0;
      border-radius: 0;
    }
    .skills > li:hover {
      background: none;
    }
  }
  @media (max-width: 680px) {
    .track {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 36px;
      margin-left: 7px;
      padding-left: 28px;
      border-left: 1px solid var(--line-strong);
    }
    .track > li {
      padding-top: 0;
    }
    .node {
      left: -36px;
      top: 2px;
    }
    .items li {
      font-size: 13.5px;
    }
  }
</style>
