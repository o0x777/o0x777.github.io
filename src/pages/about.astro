---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, getPosts } from '../lib/site';

const posts = await getPosts();

const focus = [
  '二进制漏洞挖掘与逆向分析',
  '威胁情报收集与僵尸网络追踪',
  '黑灰产溯源与治理打击',
  '业务安全建设与防御',
  '安全 BP 机制与平台化能力建设',
];
const interests = [
  { k: 'travel', v: '已访问超过 10 个国家，参与会议与探索黑客文化' },
  { k: 'games', v: '热爱复古类游戏与解谜类挑战' },
  { k: 'books', v: '喜欢阅读行为经济学、黑客历史与科幻题材' },
];
---

<Base title="关于我" description="0x777 — 网络安全从业者，专注二进制安全、僵尸网络分析与黑灰产溯源打击。">
  <div class="container">
    <header class="page-head intro">
      <div>
        <p class="eyebrow"><span class="accent">/</span> About · whoami</p>
        <h1>你好，我是 <span class="mono handle">0x777</span>。</h1>
        <p class="lead">
          一名专注于<strong>网络安全</strong>的从业者，深耕<strong>二进制安全</strong>、<strong>僵尸网络分析</strong>以及<strong
            >黑灰产业溯源打击</strong
          >方向。目前在大型业务环境中，持续攻坚安全攻防与平台治理难题。
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={`mailto:${SITE.links.email}`}><Icon name="mail" size={16} />写信给我</a>
          <a class="btn btn-ghost" href={SITE.links.x} target="_blank" rel="me noopener"
            ><Icon name="x" size={14} />{SITE.links.xHandle}</a
          >
        </div>
      </div>

      <div class="card mono" data-spot>
        <div class="card-head">
          <span>~/whoami</span>
          <span class="live"><span class="dot"></span>online</span>
        </div>
        <dl>
          <div><dt>handle</dt><dd>0x777</dd></div>
          <div><dt>role</dt><dd>security researcher</dd></div>
          <div><dt>focus</dt><dd>binary · botnet · fraud</dd></div>
          <div><dt>reports</dt><dd>{posts.length} published</dd></div>
          <div><dt>since</dt><dd>{SITE.since}</dd></div>
          <div>
            <dt>contact</dt><dd><a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a></dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="block">
      <p class="eyebrow"><span class="accent">01</span> — Focus</p>
      <h2>安全方向聚焦</h2>
      <ol class="focus">
        {
          focus.map((f, i) => (
            <li>
              <span class="mono idx">0{i + 1}</span>
              {f}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <p class="eyebrow"><span class="accent">02</span> — Off the clock</p>
      <h2>一些兴趣</h2>
      <ul class="interests">
        {
          interests.map((it) => (
            <li>
              <span class="mono k">{it.k}</span>
              <span>{it.v}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <figure class="quote">
      <blockquote>“{SITE.motto.join('')}”</blockquote>
      <figcaption>— {SITE.mottoEn}</figcaption>
    </figure>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(32px, 6vw, 80px);
  }
  .handle {
    font-weight: 600;
    color: var(--accent);
    letter-spacing: -0.04em;
  }
  .lead {
    max-width: 34em;
    margin: 0;
    color: var(--fg-2);
    font-size: 17.5px;
    line-height: 1.85;
  }
  .lead strong {
    color: var(--fg);
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-elev);
    font-size: 13px;
    overflow: hidden;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--fg-3);
    font-size: 12px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
  }
  .live .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .card dl {
    margin: 0;
    padding: 10px 18px 14px;
  }
  .card dl div {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px;
    padding: 7px 0;
  }
  .card dt {
    color: var(--fg-3);
  }
  .card dd {
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .card a {
    text-decoration: none;
  }
  .card a:hover {
    color: var(--accent-text);
  }

  .block {
    padding-top: clamp(56px, 8vw, 96px);
  }
  .block h2 {
    margin: 12px 0 28px;
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .focus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .focus li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16.5px;
  }
  .idx {
    color: var(--fg-3);
    font-size: 12px;
  }

  .interests {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .interests li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16.5px;
  }
  .k {
    padding-top: 3px;
    color: var(--fg-3);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quote {
    margin: clamp(80px, 12vw, 140px) 0 0;
    text-align: center;
  }
  .quote blockquote {
    margin: 0;
    font-size: clamp(26px, 4.4vw, 48px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .quote figcaption {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-style: italic;
    color: var(--fg-3);
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .focus {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .interests li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
