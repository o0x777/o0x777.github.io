---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CaseFile from '../components/about/CaseFile.astro';
import Terminal from '../components/about/Terminal.astro';
import { ABOUT } from '../lib/about';
import { SITE } from '../lib/site';

// "攻防出身。" on its own line, the rest below it
const [leadHead, ...leadRest] = ABOUT.lead.split(/(?<=。)/);
---

<Base title="关于我" description="0x777 — 攻防出身：拆解过代码，追踪过暗影，如今守护数据。">
  <!-- ========== Hero ========== -->
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow" data-reveal><span class="accent">/</span> About · Subject Profile</p>
      <h1 data-reveal style="--d:1">
        <span class="hi">你好，</span>
        <span>我是 <span class="handle mono" data-scramble>0x777</span>。</span>
      </h1>
      <p class="lead" data-reveal style="--d:2">
        <span class="l1">{leadHead}</span>
        <span>{leadRest.join('')}</span>
      </p>
      <div class="cta" data-reveal style="--d:3">
        <a class="btn btn-primary" href={`mailto:${SITE.links.email}`}><Icon name="mail" size={16} />发个信号</a>
        <a class="btn btn-ghost" href="#terminal">打开终端 <span class="mono prompt-glyph">›_</span></a>
      </div>
    </div>
    <div class="file" data-reveal style="--d:2">
      <CaseFile />
    </div>
  </section>

  <!-- ========== 01 Trajectory + skills ========== -->
  <section class="container section" aria-labelledby="path-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">01</span> — Trajectory · Skills</p>
        <h2 id="path-title">安全轨迹</h2>
      </div>
      <p class="note">从进攻，到守护。</p>
    </div>

    <ol class="journey" data-reveal>
      {
        ABOUT.career.map((c, i) => (
          <li class:list={{ now: c.now }} style={`--d:${i}`}>
            <span class="node" aria-hidden="true" />
            <div class="head">
              <p class="idx mono">
                0{i + 1} · {c.en}
                {c.now && <span class="now-tag">NOW</span>}
              </p>
              <h3>
                <span class="verb">{c.verb}</span>
                <span class="dom">{c.domain}</span>
              </h3>
            </div>
            <div class="detail">
              <p class="line">{c.line}</p>
              <p class="skills" aria-label={`技能：${c.skills.join('、')}`}>
                {c.skills.map((s) => (
                  <span>{s}</span>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 02 Shell ========== -->
  <section class="container section" id="terminal" aria-labelledby="term-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">02</span> — Shell</p>
        <h2 id="term-title">和我的终端聊聊</h2>
      </div>
      <p class="note">试试输入 <code class="mono">help</code></p>
    </div>
    <div data-reveal><Terminal /></div>
  </section>
</Base>

<script>
  // Decrypt effect on the handle
  const handle = document.querySelector<HTMLElement>('[data-scramble]');
  if (handle && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const final = handle.textContent!.trim();
    const glyphs = '01#$%&@!x7ABCDEF';
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start - 350) / 900);
      const locked = Math.floor(Math.max(0, p) * final.length);
      handle.textContent = [...final]
        .map((ch, i) => (i < locked ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (p < 1) requestAnimationFrame(tick);
      else handle.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  // For the people who open DevTools
  console.log(
    '%c0x777%c\n保持好奇，保持隐秘，追踪暗影。\n这一页的终端里藏着一个 flag —— 试试 ls -a',
    'font: 700 28px ui-monospace, monospace; color: #39ff88; text-shadow: 0 0 12px rgba(57,255,136,.6)',
    'font: 12px ui-monospace, monospace; color: #98a69d; line-height: 1.8',
  );
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: clamp(48px, 8vw, 104px);
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: 22px 0;
    font-size: clamp(38px, 6.2vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 .hi {
    color: var(--fg-3);
  }
  h1 > span {
    white-space: nowrap;
  }
  .handle {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.05em;
    text-shadow: 0 0 36px var(--glow);
  }
  /* One-line statement */
  .lead {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.7;
    letter-spacing: -0.01em;
    word-break: keep-all;
  }
  .lead .l1 {
    color: var(--fg);
    font-weight: 500;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .prompt-glyph {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: clamp(80px, 10vw, 128px);
  }
  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 14px;
  }
  .note code {
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent-text);
    font-size: 13px;
  }

  /* ---------- 01 Journey: vertical timeline, one row per stage ---------- */
  .journey {
    --node: 15px;
    --ny: 50%; /* vertical centre of each node */
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  /* The rail is drawn per row (::before) and filled in green row by row (::after),
     starting at the first node and ending at the current one */
  .journey > li::before,
  .journey > li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .journey > li::before {
    background: var(--line-strong);
  }
  .journey > li::after {
    background: var(--accent-line);
    transform-origin: top;
    transition: transform 0.5s var(--ease);
    transition-delay: calc(0.3s + var(--d) * 0.25s);
  }
  :global(.js) .journey:not([data-in]) > li::after {
    transform: scaleY(0);
  }
  .journey > li:first-child::before,
  .journey > li:first-child::after {
    top: var(--ny);
  }
  .journey > li:last-child::before,
  .journey > li:last-child::after {
    bottom: auto;
    height: var(--ny);
  }
  .now::after {
    background: var(--accent);
    box-shadow: 0 0 8px var(--glow);
  }

  .journey > li {
    position: relative;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    padding: 30px 0 30px 56px;
    border-bottom: 1px solid var(--line);
  }
  /* Rows light up one after another, following the fill */
  :global(.js) .journey > li {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(0.2s + var(--d) * 0.25s);
  }
  :global(.js) .journey[data-in] > li {
    opacity: 1;
    transform: none;
  }

  .node {
    position: absolute;
    z-index: 1;
    left: 0;
    top: var(--ny);
    width: var(--node);
    height: var(--node);
    margin-top: calc(var(--node) / -2);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    transition: border-color 0.3s;
  }
  .node::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--fg-3);
    transition: background-color 0.3s;
  }
  .journey > li:hover .node {
    border-color: var(--accent-line);
  }
  .journey > li:hover .node::after,
  .now .node::after {
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }
  .now .node {
    border-color: var(--accent-line);
  }
  .now .node::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: ping 2.2s var(--ease) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .idx {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .now-tag {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 9.5px;
    font-weight: 700;
  }
  .head h3 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0;
  }
  .verb {
    font-size: clamp(34px, 3.6vw, 46px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .journey > li:hover .verb {
    color: var(--accent-text);
  }
  .now .verb {
    color: var(--accent);
    text-shadow: 0 0 28px var(--glow);
  }
  .dom {
    color: var(--fg-3);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .line {
    margin: 0 0 10px;
    color: var(--fg);
    font-size: 17px;
    line-height: 1.6;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
    margin: 0;
    color: var(--fg-2);
    font-size: 15px;
    transition: color 0.3s;
  }
  /* A small bullet travels with each keyword, so wrapping never strands a separator */
  .skills span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .skills span::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  .journey > li:hover .skills {
    color: var(--fg);
  }
  .now .skills {
    color: var(--accent-text);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .file {
      max-width: 520px;
    }
    .journey > li {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 720px) {
    .journey > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding: 26px 0 26px 40px;
    }
    .journey {
      --ny: 47px;
    }
    .idx {
      margin-bottom: 10px;
    }
    .line {
      font-size: 16px;
    }
    .skills {
      font-size: 14.5px;
    }
  }
</style>
