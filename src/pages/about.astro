---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CaseFile from '../components/about/CaseFile.astro';
import Terminal from '../components/about/Terminal.astro';
import { ABOUT } from '../lib/about';
import { SITE, dateParts, getPosts, postUrl, reportIds } from '../lib/site';

const posts = await getPosts();
const ids = reportIds(posts);
---

<Base title="关于我" description="0x777 — 安全从业者，攻防出身：逆向、威胁情报、业务安全与数据安全。">
  <!-- ========== Hero ========== -->
  <section class="container hero">
    <div class="intro">
      <p class="eyebrow" data-reveal><span class="accent">/</span> About · Subject Profile</p>
      <h1 data-reveal style="--d:1">
        <span class="hi">你好，</span>
        <span>我是 <span class="handle mono" data-scramble>0x777</span>。</span>
      </h1>
      <p class="path mono" data-reveal style="--d:2" aria-label={`安全轨迹：${ABOUT.path.join('，')}`}>
        {
          ABOUT.path.map((p, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">→</span>}
              <span class:list={{ now: i === ABOUT.path.length - 1 }}>{p}</span>
            </>
          ))
        }
      </p>
      <p class="lead" data-reveal style="--d:3">{ABOUT.lead}</p>
      <div class="cta" data-reveal style="--d:4">
        <a class="btn btn-primary" href="#contact"><Icon name="mail" size={16} />发个信号</a>
        <a class="btn btn-ghost" href="#terminal">打开终端 <span class="mono prompt-glyph">›_</span></a>
      </div>
    </div>
    <div class="file" data-reveal style="--d:2">
      <CaseFile />
    </div>
  </section>

  <!-- ========== 01 Career ========== -->
  <section class="container section" aria-labelledby="career-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">01</span> — Trajectory</p>
        <h2 id="career-title">安全轨迹</h2>
      </div>
      <p class="note">攻防出身，一路走到数据安全</p>
    </div>
    <ol class="track" data-reveal>
      <span class="rail" aria-hidden="true"><span class="fill"></span></span>
      {
        ABOUT.career.map((c, i) => (
          <li class:list={{ now: c.now }} style={`--d:${i}`}>
            <span class="node" aria-hidden="true" />
            <p class="idx mono">
              0{i + 1} · {c.en}
              {c.now && <span class="now-tag">NOW</span>}
            </p>
            <h3>{c.title}</h3>
            <p class="body">{c.body}</p>
            <ul class="keys">
              {c.keys.map((k) => (
                <li class="mono">{k}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ========== 02 Skills ========== -->
  <section class="container section" aria-labelledby="skills-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">02</span> — Skills</p>
        <h2 id="skills-title">技能图谱</h2>
      </div>
    </div>
    <ul class="skills">
      {
        ABOUT.skills.map((s, i) => (
          <li data-reveal style={`--d:${i}`}>
            <div class="domain">
              <span class="d-icon">
                <Icon name={s.icon as any} size={19} />
              </span>
              <div>
                <h3>{s.domain}</h3>
                <p class="mono">{s.en}</p>
              </div>
            </div>
            <ul class="items">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ========== 03 Research ========== -->
  <section class="container section" aria-labelledby="reports-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">03</span> — Research</p>
        <h2 id="reports-title">公开研究</h2>
      </div>
      <a class="link-arrow" href="/archives/">全部归档 <span>→</span></a>
    </div>
    <div class="reports">
      {
        posts.map((p, i) => (
          <a class="report" href={postUrl(p)} data-spot data-reveal style={`--d:${i}`}>
            <div class="r-top mono">
              <span class="rid">REPORT {ids.get(p.id)}</span>
              <span>{dateParts(p.data.pubDate).year}</span>
            </div>
            <h3>{p.data.title}</h3>
            <p class="r-desc">{p.data.description}</p>
            {ABOUT.reportHighlights[p.data.slug] && (
              <dl class="metrics">
                {ABOUT.reportHighlights[p.data.slug].map((h) => (
                  <div>
                    <dt class="mono">{h.n}</dt>
                    <dd>{h.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <span class="r-go">
              阅读报告 <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ========== 04 Terminal ========== -->
  <section class="container section" id="terminal" aria-labelledby="term-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">04</span> — Shell</p>
        <h2 id="term-title">和我的终端聊聊</h2>
      </div>
      <p class="note">试试输入 <code class="mono">help</code></p>
    </div>
    <div data-reveal><Terminal /></div>
  </section>

  <!-- ========== 05 Off the clock ========== -->
  <section class="container section" aria-labelledby="life-title">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><span class="accent">05</span> — Off the clock</p>
        <h2 id="life-title">档案之外</h2>
      </div>
    </div>
    <div class="life">
      <article class="card pass" data-spot data-reveal>
        <div class="pass-head mono">
          <span>BOARDING PASS</span>
          <Icon name="plane" size={16} />
        </div>
        <div class="route mono">
          <div><small>FROM</small><b>127.0.0.1</b></div>
          <span class="arrow" aria-hidden="true"></span>
          <div class="to"><small>TO</small><b>{ABOUT.countries}</b></div>
        </div>
        <dl class="pass-meta mono">
          <div><dt>PASSENGER</dt><dd>0x777</dd></div>
          <div><dt>PURPOSE</dt><dd>CON · HACKER CULTURE</dd></div>
        </dl>
        <p>{ABOUT.interests.travel}</p>
      </article>

      <article class="card arcade" data-spot data-reveal style="--d:1">
        <div class="screen mono" aria-hidden="true">
          <div class="hud"><span>1UP 0x777</span><span>HI 7777</span></div>
          <p class="start">PRESS START</p>
          <p class="credit">CREDIT 01</p>
        </div>
        <p>{ABOUT.interests.games}</p>
        <a class="hint mono" href="#terminal">&gt; 提示：去终端里 <b>ls -a</b></a>
      </article>

      <article class="card shelf" data-spot data-reveal style="--d:2">
        <div class="books" aria-hidden="true">
          {ABOUT.interests.books.map((b, i) => <span class={`spine s${i}`}>{b}</span>)}
          <span class="spine ghost"></span>
        </div>
        <p>喜欢读{ABOUT.interests.books.join('、')}。</p>
      </article>
    </div>
  </section>

  <!-- ========== 06 Contact ========== -->
  <section class="container section" id="contact" aria-labelledby="contact-title">
    <div class="signal" data-reveal>
      <div class="radar" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow"><span class="accent">06</span> — Contact</p>
      <h2 id="contact-title">有线索？<br />发个<em>信号</em>。</h2>
      <p class="sub">{ABOUT.contact.body}</p>
      <div class="mailbox">
        <a class="addr mono" href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a>
        <button class="copy" type="button" data-copy={SITE.links.email} aria-label="复制邮箱地址">
          <Icon name="copy" size={15} class="i-copy" />
          <Icon name="check" size={15} class="i-check" />
          <span data-copy-label>复制</span>
        </button>
      </div>
      <div class="links">
        <a class="btn btn-ghost" href={SITE.links.x} target="_blank" rel="me noopener"
          ><Icon name="x" size={14} />{SITE.links.xHandle}</a
        >
        <a class="btn btn-ghost" href={SITE.links.github} target="_blank" rel="me noopener"
          ><Icon name="github" size={16} />GitHub</a
        >
        <a class="btn btn-ghost" href="/rss.xml"><Icon name="rss" size={16} />RSS</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Decrypt effect on the handle
  const handle = document.querySelector<HTMLElement>('[data-scramble]');
  if (handle && !reduced) {
    const final = handle.textContent!.trim();
    const glyphs = '01#$%&@!x7ABCDEF';
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start - 350) / 900);
      const locked = Math.floor(Math.max(0, p) * final.length);
      handle.textContent = [...final]
        .map((ch, i) => (i < locked ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (p < 1) requestAnimationFrame(tick);
      else handle.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  // Copy e-mail
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.setAttribute('data-done', '');
        label.textContent = '已复制';
      } catch {
        label.textContent = '复制失败';
      }
      setTimeout(() => {
        btn.removeAttribute('data-done');
        label.textContent = '复制';
      }, 1800);
    }),
  );

  // For the people who open DevTools
  console.log(
    '%c0x777%c\n保持好奇，保持隐秘，追踪暗影。\n这一页的终端里藏着一个 flag —— 试试 ls -a',
    'font: 700 28px ui-monospace, monospace; color: #39ff88; text-shadow: 0 0 12px rgba(57,255,136,.6)',
    'font: 12px ui-monospace, monospace; color: #98a69d; line-height: 1.8',
  );
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-top: clamp(48px, 8vw, 104px);
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin: 22px 0 22px;
    font-size: clamp(38px, 6.2vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  h1 .hi {
    color: var(--fg-3);
  }
  h1 > span {
    white-space: nowrap;
  }
  .handle {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: -0.05em;
    text-shadow: 0 0 36px var(--glow);
  }
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 22px;
    color: var(--fg-2);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .path .sep {
    color: var(--fg-3);
  }
  .path .now {
    padding: 2px 8px;
    border: 1px solid var(--accent-line);
    border-radius: 6px;
    color: var(--accent-text);
    background: var(--accent-soft);
  }
  .lead {
    max-width: 32em;
    margin: 0;
    color: var(--fg-2);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.9;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .prompt-glyph {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* ---------- Section scaffolding ---------- */
  .section {
    padding-top: clamp(96px, 12vw, 152px);
  }
  .note {
    margin: 0;
    color: var(--fg-3);
    font-size: 14px;
  }
  .note code {
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--accent-text);
    font-size: 13px;
  }

  /* ---------- Career track ---------- */
  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 7px;
    left: 8px;
    right: 8px;
    height: 1px;
    background: var(--line-strong);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--line-strong), var(--accent));
    box-shadow: 0 0 10px var(--glow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s 0.2s var(--ease);
  }
  .track[data-in] .fill {
    transform: none;
  }
  :global(html:not(.js)) .fill {
    transform: none;
  }
  .track > li {
    position: relative;
    padding-top: 40px;
  }
  /* Stages light up one after another, following the fill */
  :global(.js) .track > li {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(0.2s + var(--d) * 0.22s);
  }
  :global(.js) .track[data-in] > li {
    opacity: 1;
    transform: none;
  }
  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 15px;
    height: 15px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
  }
  .node::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--fg-3);
  }
  .now .node {
    border-color: var(--accent-line);
  }
  .now .node::after {
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }
  .now .node::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: ping 2.2s var(--ease) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .idx {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .now-tag {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 9.5px;
    font-weight: 700;
  }
  .track h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .now h3 {
    color: var(--accent-text);
  }
  .track .body {
    margin: 0 0 16px;
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.8;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .keys li {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--fg-2);
    font-size: 11.5px;
  }
  .now .keys li {
    border-color: var(--accent-line);
    color: var(--accent-text);
  }

  /* ---------- Skills matrix ---------- */
  .skills {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .skills > li {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: 22px 16px;
    margin: 0 -16px;
    border-bottom: 1px solid var(--line);
    border-radius: 14px;
    transition: background-color 0.25s;
  }
  .skills > li:hover {
    background: var(--bg-hover);
  }
  .domain {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .d-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 11px;
    color: var(--fg-2);
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .skills > li:hover .d-icon {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .domain h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  .domain p {
    margin: 2px 0 0;
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .items li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--fg-2);
    font-size: 14px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .skills > li:hover .items li {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  /* ---------- Reports ---------- */
  .reports {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .report {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-elev);
    text-decoration: none;
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease);
  }
  .report:hover {
    border-color: var(--accent-line);
    transform: translateY(-3px);
  }
  .r-top {
    display: flex;
    justify-content: space-between;
    color: var(--fg-3);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .rid {
    color: var(--accent-text);
  }
  .report h3 {
    margin: 22px 0 10px;
    font-size: clamp(22px, 2.4vw, 26px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .r-desc {
    margin: 0;
    color: var(--fg-2);
    font-size: 14.5px;
    line-height: 1.75;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
  }
  .metrics dt {
    font-size: 34px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .metrics dd {
    margin: 8px 0 0;
    color: var(--fg-3);
    font-size: 13px;
  }
  .r-go {
    display: inline-flex;
    gap: 6px;
    margin-top: 28px;
    color: var(--fg-2);
    font-size: 14px;
    transition: color 0.2s;
  }
  .r-go span {
    transition: transform 0.3s var(--ease);
  }
  .report:hover .r-go {
    color: var(--accent-text);
  }
  .report:hover .r-go span {
    transform: translateX(4px);
  }

  /* ---------- Off the clock ---------- */
  .life {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--bg-elev);
  }
  .card > p {
    margin: auto 0 0;
    padding-top: 20px;
    color: var(--fg-2);
    font-size: 14.5px;
    line-height: 1.75;
  }

  .pass-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line-strong);
    color: var(--fg-3);
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  .route {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 0 18px;
  }
  .route small {
    display: block;
    margin-bottom: 4px;
    color: var(--fg-3);
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .route b {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .route .to b {
    color: var(--accent);
    font-size: 30px;
    text-shadow: 0 0 20px var(--glow);
  }
  .route .arrow {
    position: relative;
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(to right, var(--fg-3) 0 4px, transparent 4px 8px);
  }
  .route .arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    border-left: 6px solid var(--fg-3);
    border-top: 3.5px solid transparent;
    border-bottom: 3.5px solid transparent;
  }
  .pass-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line-strong);
    font-size: 11.5px;
  }
  .pass-meta dt {
    color: var(--fg-3);
    font-size: 9.5px;
    letter-spacing: 0.14em;
  }
  .pass-meta dd {
    margin: 4px 0 0;
    color: var(--fg);
  }

  .screen {
    position: relative;
    padding: 14px 16px 16px;
