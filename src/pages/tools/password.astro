---
import Tool from '../../layouts/Tool.astro';
---

<Tool slug="password">
  <div class="stack">
    <section class="pane hero-pane">
      <div class="pane-bar">
        <span>Password</span>
        <div class="pane-acts">
          <button class="tbtn" type="button" data-regen>换一个 <span class="kbd">R</span></button>
          <button class="tbtn primary" type="button" data-copy>复制</button>
        </div>
      </div>
      <output class="pw mono" data-pw aria-live="polite"></output>
      <div class="meter" data-meter><i></i></div>
      <div class="facts mono">
        <div><b data-bits>0</b><span>熵 · bits</span></div>
        <div><b data-crack>—</b><span>离线暴力破解*</span></div>
        <div><b data-verdict>—</b><span>强度</span></div>
      </div>
    </section>

    <div class="cols-2">
      <section class="pane">
        <div class="pane-bar"><span>长度</span><span class="n mono" data-len-out>20</span></div>
        <div class="pane-body">
          <input class="range" id="pw-len" type="range" min="6" max="64" value="20" aria-label="口令长度" />
          <div class="opts">
            <label class="opt"><input type="checkbox" data-set="lower" checked />a-z</label>
            <label class="opt"><input type="checkbox" data-set="upper" checked />A-Z</label>
            <label class="opt"><input type="checkbox" data-set="digit" checked />0-9</label>
            <label class="opt"><input type="checkbox" data-set="symbol" checked />!@#$</label>
            <label class="opt"><input type="checkbox" id="pw-amb" />去除易混 Il1O0</label>
          </div>
        </div>
      </section>
      <section class="pane">
        <div class="pane-bar">
          <span>候选</span>
          <button class="tbtn" type="button" data-batch>再来一批</button>
        </div>
        <ul class="batch mono" data-list></ul>
      </section>
    </div>
  </div>
  <p class="hint">
    随机源是浏览器的 <code>crypto.getRandomValues</code>，拒绝采样消除取模偏差，保证每个选中的字符类至少出现一次。*按每秒 10<sup>11</sup> 次猜测估算（多卡 GPU 对付快速哈希的量级），取平均耗时。
  </p>
</Tool>

<script>
  import { $, $$, copy, esc, humanDuration, randInt } from '../../lib/tool-client';

  const SETS: Record<string, string> = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digit: '0123456789',
    symbol: '!@#$%^&*()-_=+[]{};:,.?/~',
  };
  const AMBIGUOUS = /[Il1O0o|`'"]/g;
  const GUESSES_PER_SEC = 1e11;

  const pwEl = $('[data-pw]');
  const lenIn = $<HTMLInputElement>('#pw-len');
  const amb = $<HTMLInputElement>('#pw-amb');
  const listEl = $('[data-list]');
  const meter = $('[data-meter]');

  function pools() {
    return $$<HTMLInputElement>('[data-set]')
      .filter((c) => c.checked)
      .map((c) => (amb.checked ? SETS[c.dataset.set!].replace(AMBIGUOUS, '') : SETS[c.dataset.set!]));
  }

  function generate(len: number, ps: string[]) {
    const all = ps.join('');
    // Rejection: redraw until every chosen class shows up (cheap for sane lengths)
    for (;;) {
      const pw = Array.from({ length: len }, () => all[randInt(all.length)]).join('');
      if (len < ps.length || ps.every((p) => [...pw].some((ch) => p.includes(ch)))) return pw;
    }
  }

  // Highlight digits and symbols so the password is easier to read back
  const paint = (pw: string) =>
    [...pw]
      .map((ch) => (/\d/.test(ch) ? `<span class="d">${ch}</span>` : /[a-z]/i.test(ch) ? esc(ch) : `<span class="s">${esc(ch)}</span>`))
      .join('');

  let current = '';
  function render() {
    // Keep at least one class on
    const boxes = $$<HTMLInputElement>('[data-set]');
    if (!boxes.some((b) => b.checked)) boxes[0].checked = true;

    const ps = pools();
    const len = +lenIn.value;
    lenIn.style.setProperty('--p', `${((len - 6) / 58) * 100}%`);
    $('[data-len-out]').textContent = String(len);

    current = generate(len, ps);
    pwEl.innerHTML = paint(current);
    pwEl.classList.remove('flash');
    void pwEl.offsetWidth;
    pwEl.classList.add('flash');

    const bits = len * Math.log2(ps.join('').length);
    const secs = 2 ** bits / 2 / GUESSES_PER_SEC;
    const [verdict, lvl] =
      bits < 50 ? ['弱', 'bad'] : bits < 80 ? ['一般', 'mid'] : bits < 110 ? ['强', 'good'] : ['极强', 'great'];
    $('[data-bits]').textContent = bits.toFixed(0);
    $('[data-crack]').textContent = humanDuration(secs);
    $('[data-verdict]').textContent = verdict;
    meter.dataset.lvl = lvl;
    meter.style.setProperty('--w', `${Math.min(100, (bits / 128) * 100)}%`);

    listEl.innerHTML = Array.from(
      { length: 6 },
      () => `<li><button type="button">${esc(generate(len, ps))}</button></li>`,
    ).join('');
  }

  lenIn.addEventListener('input', render);
  $$('[data-set], #pw-amb').forEach((c) => c.addEventListener('change', render));
  $('[data-regen]').addEventListener('click', render);
  $('[data-batch]').addEventListener('click', render);
  $('[data-copy]').addEventListener('click', (e) => copy(current, e.currentTarget as HTMLElement));
  listEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    copy(b.textContent!);
    b.parentElement!.setAttribute('data-done', '');
    setTimeout(() => b.parentElement?.removeAttribute('data-done'), 900);
  });
  addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 'r' || e.metaKey || e.ctrlKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input[type=text], textarea, dialog')) return;
    render();
  });

  render();
</script>

<style>
  .pw {
    display: block;
    padding: clamp(28px, 5vw, 44px) 20px clamp(20px, 4vw, 32px);
    font-size: clamp(20px, 3.6vw, 34px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-align: center;
    word-break: break-all;
  }
  .pw :global(.d) {
    color: var(--accent-text);
  }
  .pw :global(.s) {
    color: var(--warn);
  }
  :global(.tool) .pw.flash {
    animation: decode 0.5s var(--ease);
  }
  @keyframes decode {
    from {
      opacity: 0.2;
      filter: blur(6px);
      letter-spacing: 0.2em;
    }
  }

  .meter {
    height: 3px;
    margin: 0 20px;
    border-radius: 3px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .meter i {
    display: block;
    width: var(--w, 0);
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    box-shadow: 0 0 12px var(--glow);
    transition:
      width 0.4s var(--ease),
      background-color 0.3s;
  }
  .meter[data-lvl='bad'] i {
    background: var(--danger);
  }
  .meter[data-lvl='mid'] i {
    background: var(--warn);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 20px 4px 22px;
    text-align: center;
  }
  .facts div + div {
    border-left: 1px solid var(--line);
  }
  .facts b {
    display: block;
    font-size: clamp(16px, 2.4vw, 22px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .facts span {
    display: block;
    margin-top: 6px;
    color: var(--fg-3);
    font-size: 11.5px;
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .batch {
    margin: 0;
    padding: 6px 0;
    list-style: none;
  }
  .batch :global(li) {
    transition: background-color 0.15s;
  }
  .batch :global(li:hover) {
    background: var(--bg-hover);
  }
  .batch :global(li[data-done]) {
    background: var(--accent-soft);
  }
  .batch :global(button) {
    display: block;
    width: 100%;
    padding: 7px 16px;
    border: 0;
    background: none;
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: left;
    word-break: break-all;
    cursor: copy;
  }
  .tbtn .kbd {
    height: 16px;
    min-width: 16px;
    font-size: 10px;
  }
</style>
