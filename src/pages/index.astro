---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE, getPosts } from '../lib/site';

const posts = await getPosts();
---

<Base>
  <section class="hero">
    <p class="cmd mono"><span class="muted">$</span> whoami</p>
    <h1>0x777</h1>
    <p class="lead">
      网络安全从业者。关注<strong>二进制安全</strong>、<strong>僵尸网络分析</strong>与<strong
        >黑灰产溯源打击</strong
      >，在这里记录样本分析、威胁追踪和一些思考。
    </p>
    <p class="motto mono">// {SITE.motto}</p>
  </section>

  <h2 class="section-title">文章 · {posts.length}</h2>
  <PostList posts={posts} />
</Base>

<style>
  .hero {
    padding: 2.5rem 0 0.5rem;
  }
  .cmd {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--accent);
  }
  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0 0 1rem;
    max-width: 36rem;
    font-size: 1.1rem;
    color: var(--fg-soft);
  }
  .motto {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
