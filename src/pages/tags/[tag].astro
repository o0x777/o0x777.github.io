---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, type Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签「${tag}」下的 ${posts.length} 篇文章`}>
  <p class="back mono"><a href="/tags/">← 全部标签</a></p>
  <h1 class="page-title mono">#{tag}</h1>
  <p class="muted">{posts.length} 篇文章</p>
  <PostList posts={posts} />
</Base>

<style>
  .back {
    margin: 2rem 0 0.5rem;
    font-size: 0.82rem;
  }
  .back a {
    color: var(--muted);
    text-decoration: none;
  }
  .page-title {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
    color: var(--accent);
  }
</style>
