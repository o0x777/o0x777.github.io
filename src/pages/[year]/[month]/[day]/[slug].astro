---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import Mark from '../../../../components/Mark.astro';
import {
  SITE,
  dateParts,
  formatDate,
  getPosts,
  postUrl,
  readingMinutes,
  reportIds,
  tagUrl,
  vtName,
  wordCount,
  type Post,
} from '../../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const ids = reportIds(posts);
  return posts.map((post, i) => ({
    params: { ...dateParts(post.data.pubDate), slug: post.data.slug },
    // List is newest first: "newer" is the previous index
    props: { post, rid: ids.get(post.id)!, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  rid: string;
  newer?: Post;
  older?: Post;
}

const { post, rid, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, categories, tags } = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showUpdated = updatedDate && formatDate(updatedDate) !== formatDate(pubDate);
const words = wordCount(post.body);
---

<Base title={title} description={description} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <div class="progress" aria-hidden="true"><span></span></div>

  <article class="article">
    <header class="container-read post-head">
      <a class="back link-arrow" href="/"><span>←</span> 全部报告</a>

      <div class="kicker mono">
        <span class="rid">REPORT {rid}</span>
        <span class="tlp" title="Traffic Light Protocol：可公开分享">TLP:CLEAR</span>
        {categories.length > 0 && <span class="cats">{categories.join(' / ')}</span>}
      </div>

      <h1 style={`view-transition-name:${vtName(post)}`}>{title}</h1>
      {description && <p class="lead">{description}</p>}

      <dl class="dossier">
        <div>
          <dt>发布</dt>
          <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate, '.')}</time></dd>
        </div>
        <div>
          <dt>更新</dt>
          <dd>
            {
              showUpdated ? (
                <time datetime={updatedDate!.toISOString()}>{formatDate(updatedDate!, '.')}</time>
              ) : (
                '—'
              )
            }
          </dd>
        </div>
        <div>
          <dt>篇幅</dt>
          <dd>{words.toLocaleString('en-US')} 字</dd>
        </div>
        <div>
          <dt>阅读</dt>
          <dd>约 {readingMinutes(post.body)} 分钟</dd>
        </div>
      </dl>

      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a class="chip" href={tagUrl(tag)}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="container body-grid">
      {
        toc.length >= 3 && (
          <aside class="toc-rail" aria-label="目录">
            <div class="toc-sticky">
              <p class="eyebrow">目录</p>
              <ol class="toc">
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={`#${h.slug}`} data-toc={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
              <button class="to-top link-arrow" type="button" data-to-top>
                <Icon name="arrowUp" size={14} /> 回到顶部
              </button>
            </div>
          </aside>
        )
      }

      <div class="body-col">
        {
          toc.length >= 3 && (
            <details class="toc-inline">
              <summary>
                <span class="eyebrow">目录</span>
                <span class="mono muted">{toc.length} 节</span>
              </summary>
              <ol class="toc">
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="prose" data-prose>
          <Content />
        </div>

        <p class="eof mono" aria-hidden="true">EOF · {rid}</p>

        <aside class="author" data-spot>
          <Mark size={36} />
          <div>
            <p class="author-name">0x777</p>
            <p class="author-bio">二进制安全 · 僵尸网络分析 · 黑灰产溯源。{SITE.motto.join('')}</p>
          </div>
          <div class="author-links">
            <a class="icon-btn" href={SITE.links.x} target="_blank" rel="me noopener" aria-label="X / Twitter">
              <Icon name="x" size={15} />
            </a>
            <a class="icon-btn" href="/rss.xml" aria-label="RSS 订阅"><Icon name="rss" size={16} /></a>
          </div>
        </aside>

        <nav class="pager" aria-label="更多报告">
          {
            older ? (
              <a class="older" href={postUrl(older)} data-spot>
                <span class="eyebrow">← 上一篇</span>
                <span class="pt">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="newer" href={postUrl(newer)} data-spot>
                <span class="eyebrow">下一篇 →</span>
                <span class="pt">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </article>
</Base>

<script>
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;

  // Reading progress
  const bar = document.querySelector<HTMLElement>('.progress span')!;
  const updateProgress = () => {
    const r = prose.getBoundingClientRect();
    const total = r.height - innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
  updateProgress();

  // Heading anchors
  prose.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'h-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `链接到「${h.textContent}」`);
    h.prepend(a);
  });

  // Code blocks: language label + copy button
  prose.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
    const frame = document.createElement('div');
    frame.className = 'code-frame';
    pre.before(frame);
    frame.append(pre);
    const head = document.createElement('div');
    head.className = 'code-head';
    const lang = document.createElement('span');
    lang.className = 'code-lang';
    lang.textContent = pre.dataset.language || 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = '已复制 ✓';
        btn.setAttribute('data-done', '');
      } catch {
        btn.textContent = '复制失败';
      }
      setTimeout(() => {
        btn.textContent = '复制';
        btn.removeAttribute('data-done');
      }, 1600);
    });
    head.append(lang, btn);
    frame.prepend(head);
  });

  // Image zoom: the image flies from its spot to the center of the screen
  prose.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
    img.addEventListener('click', () => {
      const from = img.getBoundingClientRect();
      const nw = img.naturalWidth || from.width;
      const nh = img.naturalHeight || from.height;
      const scale = Math.min((innerWidth - 48) / nw, (innerHeight - 48) / nh, Math.max(1, 1.6 * (from.width / nw)));
      const w = nw * scale;
      const h = nh * scale;
      const k = w / from.width;
      const dx = (innerWidth - w) / 2 - from.left;
      const dy = (innerHeight - h) / 2 - from.top;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox';
      const clone = document.createElement('img');
      clone.className = 'lightbox-img';
      clone.src = img.currentSrc || img.src;
      clone.alt = img.alt;
      Object.assign(clone.style, {
        left: `${from.left}px`,
        top: `${from.top}px`,
        width: `${from.width}px`,
        height: `${from.height}px`,
      });
      document.body.append(overlay, clone);
      img.style.visibility = 'hidden';
      requestAnimationFrame(() => {
        overlay.setAttribute('data-open', '');
        clone.style.transform = `translate(${dx}px, ${dy}px) scale(${k})`;
      });

      const close = () => {
        overlay.removeAttribute('data-open');
        clone.style.transform = '';
        clone.addEventListener(
          'transitionend',
          () => {
            overlay.remove();
            clone.remove();
            img.style.visibility = '';
          },
          { once: true },
        );
        removeEventListener('keydown', onKey);
        removeEventListener('scroll', close);
      };
      const onKey = (e: KeyboardEvent) => e.key === 'Escape' && close();
      overlay.addEventListener('click', close);
      clone.addEventListener('click', close);
      addEventListener('keydown', onKey);
      addEventListener('scroll', close, { once: true, passive: true });
    });
  });

  // TOC scrollspy
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]),
  );
  if (links.size) {
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const setActive = () => {
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) current = h;
      links.forEach((a, id) => a.toggleAttribute('data-active', id === current?.id));
    };
    addEventListener('scroll', setActive, { passive: true });
    setActive();
  }
  document
    .querySelector('[data-to-top]')
    ?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 2px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ---------- Header ---------- */
  .post-head {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 8px;
  }
  .back {
    font-size: 13.5px;
  }
  .back span {
    display: inline-block;
  }
  .back:hover span {
    transform: translateX(-3px);
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 40px 0 20px;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .rid {
    color: var(--accent-text);
  }
  .tlp {
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--fg-2);
    font-size: 10.5px;
    letter-spacing: 0.1em;
  }
  .cats {
    color: var(--fg-3);
  }

  h1 {
    margin: 0;
    font-size: clamp(32px, 5.2vw, 52px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 24px 0 0;
    color: var(--fg-2);
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.8;
  }

  .dossier {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 40px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .dossier div {
    padding: 16px 0 16px 18px;
    border-left: 1px solid var(--line);
  }
  .dossier div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .dossier dt {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
  }
  .dossier dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Body + TOC rail ---------- */
  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--w-read)) minmax(0, 1fr);
    column-gap: 56px;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .body-col {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }
  .toc-rail {
    grid-column: 3;
    grid-row: 1;
  }
  .toc-sticky {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    max-width: 240px;
  }
  .toc {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc li.d3 a {
    padding-left: 28px;
    font-size: 13px;
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 16px;
    border-left: 1px solid transparent;
    color: var(--fg-3);
    font-size: 13.5px;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .toc a:hover {
    color: var(--fg);
  }
  .toc a[data-active] {
    color: var(--fg);
    border-left-color: var(--accent);
  }
  .to-top {
    margin-top: 24px;
    padding: 0;
    border: 0;
    background: none;
    font-size: 13px;
    cursor: pointer;
  }

  .toc-inline {
    display: none;
    margin-bottom: 40px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-elev);
  }
  .toc-inline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline .muted {
    color: var(--fg-3);
    font-size: 12px;
  }
  .toc-inline .toc {
    margin: 0 18px 16px;
  }

  @media (max-width: 1240px) {
    .body-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(var(--w-read) + var(--gutter) * 2);
    }
    .body-col {
      grid-column: 1;
    }
    .toc-rail {
      display: none;
    }
    .toc-inline {
      display: block;
    }
  }

  /* ---------- End of article ---------- */
  .eof {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 72px 0 32px;
    color: var(--fg-3);
    font-size: 11.5px;
    letter-spacing: 0.12em;
  }
  .eof::before,
  .eof::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .author {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg-elev);
  }
  .author-name {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
  }
  .author-bio {
    margin: 2px 0 0;
    color: var(--fg-2);
    font-size: 14px;
  }
  .author-links {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .pager a:hover {
    border-color: var(--line-strong);
  }
  .pager .pt {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
  }
  .pager .newer {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 640px) {
    .dossier {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dossier div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .dossier div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .author {
      flex-wrap: wrap;
    }
    .author-links {
      margin-left: 54px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .newer {
      grid-column: 1;
    }
  }
</style>
