---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import {
  dateParts,
  formatDate,
  getPosts,
  postUrl,
  readingMinutes,
  tagUrl,
  type Post,
} from '../../../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { ...dateParts(post.data.pubDate), slug: post.data.slug },
    // List is newest first: "newer" is the previous index
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, categories, tags } = post.data;
const toc = headings.filter((h) => h.depth <= 3);
const minutes = readingMinutes(post.body);
const showUpdated = updatedDate && formatDate(updatedDate) !== formatDate(pubDate);
---

<Base title={title} description={description} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <article>
    <header class="post-header">
      {categories.length > 0 && <p class="crumbs mono">{categories.join(' / ')}</p>}
      <h1>{title}</h1>
      <p class="meta mono">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          showUpdated && (
            <span>
              更新于 <time datetime={updatedDate!.toISOString()}>{formatDate(updatedDate!)}</time>
            </span>
          )
        }
        <span>约 {minutes} 分钟</span>
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={tagUrl(tag)}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      toc.length >= 3 && (
        <details class="toc">
          <summary class="mono">目录</summary>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="更多文章">
    {
      older ? (
        <a class="older" href={postUrl(older)}>
          <span class="mono muted">← 上一篇</span>
          <span>{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a class="newer" href={postUrl(newer)}>
          <span class="mono muted">下一篇 →</span>
          <span>{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Click an image to see it full size
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    img.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.className = 'zoom-overlay';
      const big = document.createElement('img');
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      overlay.append(big);
      const close = () => {
        overlay.remove();
        document.removeEventListener('keydown', onKey);
      };
      const onKey = (e: KeyboardEvent) => e.key === 'Escape' && close();
      overlay.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
      document.body.append(overlay);
    });
  });
</script>

<style>
  .post-header {
    padding: 2rem 0 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .crumbs {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    color: var(--accent);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0 0 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .toc {
    margin: 0 0 2.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-soft);
    font-size: 0.925rem;
  }
  .toc summary {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .toc ol {
    list-style: none;
    margin: 0.75rem 0 0.25rem;
    padding: 0;
  }
  .toc li {
    margin: 0.2rem 0;
    line-height: 1.6;
  }
  .toc li.d3 {
    padding-left: 1.25rem;
    font-size: 0.875rem;
  }
  .toc a {
    color: var(--fg-soft);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    line-height: 1.5;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager .mono {
    font-size: 0.78rem;
  }
  .pager .newer {
    text-align: right;
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
